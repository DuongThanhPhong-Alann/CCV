
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=erd_studio
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-secret

# Server-only Supabase credentials. Keep the secret key out of NEXT_PUBLIC_* variables.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Optional Email Notification (Gmail SMTP App Password - fast & sends to any address)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=ERD & Code Studio <your-gmail@gmail.com>
# Optional alternative: RESEND_API_KEY=re_replace_me
